    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>hasWeatherEvent</rdfs:label>
  </owl:ObjectProperty>

