<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ns="http://example.org/weather-ontology#">

  <!-- 本体声明 -->
  <owl:Ontology rdf:about="http://example.org/weather-ontology">
    <rdfs:comment>从 weather_data.csv 自动生成的天气本体</rdfs:comment>
  </owl:Ontology>

  <!-- ========== 类定义 ========== -->
  <owl:Class rdf:about="http://example.org/weather-ontology#WeatherRecord">
    <rdfs:label>WeatherRecord</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#WeatherEvent">
    <rdfs:label>WeatherEvent</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#FrostDay">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>FrostDay</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#HeatDay">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>HeatDay</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#SevereHeatDay">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>SevereHeatDay</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#DryDay">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>DryDay</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#StrongWindDay">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>StrongWindDay</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#DustStormRisk">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>DustStormRisk</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/weather-ontology#RainyDay">
    <rdfs:subClassOf rdf:resource="http://example.org/weather-ontology#WeatherEvent"/>
    <rdfs:label>RainyDay</rdfs:label>
  </owl:Class>

  <!-- ========== 数据属性 ========== -->
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasMaxTemp">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>hasMaxTemp</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasMinTemp">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>hasMinTemp</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasPrecipitation">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>hasPrecipitation</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasWindSpeed">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>hasWindSpeed</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasHumidity">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>hasHumidity</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasDate">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label>hasDate</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasDryStreak">
    <rdfs:domain rdf:resource="http://example.org/weather-ontology#WeatherRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>hasDryStreak</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/weather-ontology#hasRainStreak">
